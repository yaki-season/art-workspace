{
  "schemaVersion": 8,
  "id": "YS-ASSET-PIPELINE-v8",
  "sourceStyleProfile": "YS-HANDCRAFTED-NIGHT-v1",
  "generationRule": {
    "mode": "single-purpose",
    "onePromptPerAsset": true,
    "wholeScreenMastersDeprecated": true,
    "note": "한 프롬프트는 한 자산(한 상태)만 생성한다. 화면 전체를 한 장에 담아 분리하지 않는다."
  },
  "profiles": {
    "complete-layer": {
      "description": "FHD scene-coordinate layer with visible-cutout, occluded-surface completion, isolated review, and FHD/720p recomposition.",
      "creationBatchLimit": 1,
      "requiredSchemas": [
        "completion-report",
        "provenance",
        "optimization-report",
        "final-approval",
        "runtime-entry-template",
        "runtime-handoff"
      ]
    },
    "standalone-raster": {
      "description": "One independently sized PNG/WebP icon, UI skin, food, drink, prop, or other single raster asset.",
      "creationBatchLimit": 1,
      "requiredSchemas": [
        "standalone-raster-report",
        "provenance",
        "optimization-report",
        "final-approval",
        "runtime-entry-template",
        "runtime-handoff"
      ]
    },
    "bundle-model": {
      "description": "An atomic multi-file atlas, GLB, texture, metadata, or companion bundle.",
      "creationBatchLimit": 1,
      "requiredSchemas": [
        "bundle-model-report",
        "provenance",
        "optimization-report",
        "final-approval",
        "runtime-entry-template",
        "runtime-handoff"
      ]
    }
  },
  "gates": [
    {
      "order": 1,
      "id": "generate-and-isolated-review",
      "approval": "user",
      "batchLimit": 1,
      "requiredEvidence": [
        "profile",
        "semanticOwner",
        "assetMeaning",
        "sourceEvidence",
        "oneCandidateAsset",
        "isolatedReview",
        "sourceSha256",
        "outputSha256",
        "approvalStatus"
      ]
    },
    {
      "order": 2,
      "id": "consumer-context-final",
      "approval": "user",
      "requiredEvidence": [
        "screenUnit",
        "approvedAssetsOnly",
        "fhdRecomposition",
        "hdRecomposition",
        "anchorOcclusionReview",
        "styleRegressionReview",
        "optimizedBundle",
        "lossPolicy",
        "visualRegression",
        "performanceBudget",
        "userDecision"
      ]
    },
    {
      "order": 3,
      "id": "runtime-registration",
      "approval": "automated-on-final-approval",
      "requiredEvidence": [
        "allPriorGatesPassed",
        "derivedRuntimeRegistrationAllowed",
        "runtimeHandoff",
        "explicitWrite",
        "atomicBundleCommit",
        "postPromotionValidation"
      ]
    }
  ],
  "schemaCatalog": {
    "completion-report": "schemas/completion-report.schema.json",
    "standalone-raster-report": "schemas/standalone-raster-report.schema.json",
    "bundle-model-report": "schemas/bundle-model-report.schema.json",
    "optimization-report": "schemas/optimization-report.schema.json",
    "final-approval": "schemas/final-approval.schema.json",
    "provenance": "schemas/provenance.schema.json",
    "runtime-entry-template": "schemas/runtime-entry-template.schema.json",
    "runtime-handoff": "schemas/runtime-handoff.schema.json"
  },
  "deprecatedSchemas": {
    "note": "v7 스키마 파일은 삭제하지 않고 보존하되 v8 필수 목록에서 제외한다.",
    "removed": [
      "screen-topology-registry",
      "spatial-inference",
      "visible-cutout",
      "recomposition-report"
    ]
  },
  "approvalStatuses": [
    "pending-user-review",
    "approved-by-user",
    "rejected-by-user",
    "needs-revalidation"
  ],
  "referenceChangeRule": {
    "hashMismatchAlwaysBlocks": true,
    "impactAnalysisRequired": true,
    "userReapprovalRequiredWhen": [
      "meaning-changed",
      "spatial-contract-changed",
      "visual-contract-changed",
      "runtime-behavior-changed"
    ],
    "recordRefreshAllowedWhen": [
      "path-only",
      "version-label-only",
      "non-semantic-wording-only",
      "repository-boundary-only"
    ]
  },
  "versionRule": {
    "sourceRevisionChangesWhen": "meaning, decoded visual, alpha edge, dimensions, pivot, anchor, clip, geometry, material, animation, or runtime behavior changes",
    "runtimeBuildChangesWhen": "the approved source revision is re-encoded, repacked, or metadata-stripped without changing the approved visual and runtime contract",
    "sha256AlwaysMatchesExactBytes": true,
    "oneActiveRuntimeBuildPerAssetId": true
  },
  "lossPolicy": {
    "losslessRequiredFor": [
      "ui-icon",
      "alpha-cutout",
      "atlas",
      "pixel-art",
      "data-texture"
    ],
    "lossyAllowedFor": [
      "opaque-background"
    ],
    "lossyRequiresAutomatedRegression": true,
    "lossyRequiresUserVisualApproval": true
  },
  "runtimeRule": {
    "sourceWorkspace": "art-workspace",
    "runtimeRepository": "app",
    "handoffCommand": "node art-workspace/pipeline/finalize-runtime-handoff.mjs",
    "promotionCommand": "npm run assets:promote",
    "validationCommand": "npm run assets:validate",
    "runtimeRegistrationAllowedIsDerived": true,
    "dryRunReceiptRequired": false,
    "writeFlag": "--write",
    "atomicBundleWithRollback": true,
    "finalApprovalScope": "consumer-screen-unit"
  },
  "storageRule": {
    "implementationRepository": "app",
    "approvedArtRepository": "private-git-lfs",
    "pendingBinariesRemoteAllowed": false,
    "rejectedBinariesRemoteAllowed": false,
    "rejectionLedger": "REJECTIONS.md",
    "rewriteHistoryForLaterDeprecation": false
  },
  "transparencyModes": {
    "opaque-full-frame": {
      "transparentPixels": 0,
      "partialAlphaPixels": 0
    },
    "alpha-cutout": {
      "requiresTransparentPixels": true,
      "requiresOpaquePixels": true,
      "requiresTransparentCorners": true
    }
  },
  "reviewCompositionModes": {
    "isolated-alpha-checkerboard": {
      "requiredForTransparencyMode": "alpha-cutout",
      "subjectAssetOnly": true,
      "forbiddenVisibleCategories": [
        "other-customers",
        "food-or-drink",
        "state-ui",
        "navigation-ui",
        "counter",
        "background-scene"
      ],
      "pixelRule": "transparent pixels equal checkerboard; opaque pixels equal source; partial-alpha pixels equal source composited over checkerboard"
    }
  }
}

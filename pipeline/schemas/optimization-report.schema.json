{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yaki-season.local/pipeline/optimization-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "screenUnit", "profile", "sourceRevision",
    "runtimeBuild", "status", "input", "artifacts", "lossPolicy",
    "visualRegression", "performanceBudget"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^(?!.*-R[0-9]+$)[A-Z0-9-]+$" },
    "screenUnit": { "type": "string", "minLength": 1, "not": { "const": "REQUIRED" } },
    "profile": { "enum": ["complete-layer", "standalone-raster", "bundle-model"] },
    "sourceRevision": { "type": "integer", "minimum": 1 },
    "runtimeBuild": { "type": "integer", "minimum": 1 },
    "status": { "const": "passed" },
    "input": { "$ref": "#/$defs/fileEvidence" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "file", "url", "sha256", "bytes", "format"],
        "properties": {
          "role": { "type": "string", "minLength": 1, "not": { "const": "REQUIRED" } },
          "file": { "type": "string", "minLength": 1, "not": { "const": "REQUIRED" } },
          "url": { "type": "string", "pattern": "^/assets/[a-z0-9./-]+$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 1 },
          "format": { "enum": ["jpeg", "png", "webp", "glb", "json"] },
          "dimensions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["width", "height"],
            "properties": {
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "format": { "enum": ["jpeg", "png", "webp"] }
              },
              "required": ["format"]
            },
            "then": {
              "properties": { "dimensions": true },
              "required": ["dimensions"]
            }
          }
        ]
      }
    },
    "lossPolicy": { "enum": ["lossless-required", "lossy-background-approved"] },
    "visualRegression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "method", "userApprovalRequired"],
      "properties": {
        "result": { "const": "passed" },
        "method": { "type": "string", "minLength": 1, "not": { "const": "REQUIRED" } },
        "userApprovalRequired": { "type": "boolean" },
        "userApproval": {
          "type": "object",
          "required": ["status", "date", "basis"],
          "properties": {
            "status": { "const": "approved-by-user" },
            "date": { "type": "string", "format": "date" },
            "basis": { "type": "string", "minLength": 1, "not": { "const": "REQUIRED" } }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "userApprovalRequired": { "const": true } },
            "required": ["userApprovalRequired"]
          },
          "then": {
            "properties": { "userApproval": {} },
            "required": ["userApproval"]
          }
        }
      ]
    },
    "performanceBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "checks"],
      "properties": {
        "result": { "const": "passed" },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "not": { "const": "REQUIRED" } }
        }
      }
    }
  },
  "$defs": {
    "fileEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": { "type": "string", "minLength": 1, "not": { "const": "REQUIRED" } },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}

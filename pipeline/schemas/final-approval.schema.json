{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yaki-season.local/pipeline/final-approval.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "screenUnit", "status", "assets",
    "recomposition", "optimizations", "userDecision"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1, "not": { "const": "REQUIRED" } },
    "screenUnit": { "type": "string", "minLength": 1, "not": { "const": "REQUIRED" } },
    "status": { "const": "approved-by-user" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!.*-R[0-9]+$)[A-Z0-9-]+$"
      }
    },
    "recomposition": { "$ref": "#/$defs/fileEvidence" },
    "optimizations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fileEvidence" }
    },
    "userDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "basis"],
      "properties": {
        "date": { "type": "string", "format": "date" },
        "basis": { "type": "string", "minLength": 1, "not": { "const": "REQUIRED" } }
      }
    }
  },
  "$defs": {
    "fileEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": { "type": "string", "minLength": 1, "not": { "const": "REQUIRED" } },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}

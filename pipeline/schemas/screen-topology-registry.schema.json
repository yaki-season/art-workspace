{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yaki-season.local/pipeline/screen-topology-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "entries": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceMasterId", "screenUnits", "approvalStatus"],
        "properties": {
          "sourceMasterId": { "type": "string", "pattern": "^CM-[A-Z0-9-]+-R[0-9]+$" },
          "screenUnits": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "not": { "const": "REQUIRED" } }
          },
          "approvalStatus": {
            "enum": ["pending-user-review", "approved-by-user", "rejected-by-user", "needs-revalidation"]
          },
          "reason": { "type": "string", "minLength": 1, "not": { "const": "REQUIRED" } },
          "approval": {
            "type": "object",
            "additionalProperties": false,
            "required": ["date", "basis"],
            "properties": {
              "date": { "type": "string", "format": "date" },
              "basis": { "type": "string", "minLength": 1, "not": { "const": "REQUIRED" } }
            }
          },
          "topology": {
            "type": "object",
            "additionalProperties": false,
            "required": ["spatialOrder", "relations", "invariants", "forbiddenSubstitutions"],
            "properties": {
              "spatialOrder": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1, "not": { "const": "REQUIRED" } }
              },
              "relations": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": { "type": "string", "minLength": 1, "not": { "const": "REQUIRED" } }
              },
              "invariants": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1, "not": { "const": "REQUIRED" } }
              },
              "forbiddenSubstitutions": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1, "not": { "const": "REQUIRED" } }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "approvalStatus": { "const": "approved-by-user" } },
              "required": ["approvalStatus"]
            },
            "then": {
              "required": ["approval", "topology"],
              "properties": {
                "approval": true,
                "topology": true
              }
            },
            "else": {
              "required": ["reason"],
              "properties": {
                "reason": true
              }
            }
          }
        ]
      }
    }
  }
}
